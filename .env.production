# API 서버 URL (Production)
# 비워두면 same-origin 상대경로로 요청이 나가고, nginx.conf가 /api/ → admin_be(30083),
# /pod-status/ → config-server(30082)로 나눠서 프록시한다.
# 여기에 admin_be 주소를 절대경로로 박으면 /pod-status/ 요청도 nginx를 건너뛰고
# admin_be로 직접 가버려 404가 난다 (실제로 발생했던 장애).
VITE_API_BASE_URL=

# 환경 설정
VITE_NODE_ENV=production
